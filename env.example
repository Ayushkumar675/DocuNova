# ==========================================
# DocuNova Boilerplate Environment Configuration
# ==========================================

# 1. NVIDIA NIM Service Credentials
# Get your API key from https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_REASONING_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_REASONING_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# Optional: NVIDIA Reranker (separate credential if your account requires it)
NVIDIA_RERANKER_API_KEY=
NVIDIA_RERANKER_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2
NVIDIA_RERANKER_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-nemotron-rerank-vl-1b-v2/reranking

# Optional: NVIDIA Vision Model
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
NVIDIA_VISION_FALLBACK_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_VISION_TIMEOUT_SECONDS=30
NVIDIA_VISION_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Local OCR (Tesseract 5)
TESSERACT_CMD=tesseract
TESSERACT_LANG=eng

# 2. Qdrant Vector Database
# By default, points to the isolated boilerplate Docker container on port 6337
QDRANT_URL=http://localhost:6337
QDRANT_API_KEY=
QDRANT_COLLECTION=docunova_boilerplate

# 3. Storage Paths & Metadata
METADATA_DB_PATH=./data/docunova.db
DOCUMENT_STORE_PATH=./data/documents
PROCESSED_STORE_PATH=./data/processed
INDEX_STORE_PATH=./data/indexes

# 4. Ingestion & Retrieval Limits
MAX_UPLOAD_SIZE_BYTES=52428800
RETRIEVAL_MODE=hybrid
FRONTEND_ORIGIN=http://localhost:3000

# 5. Observability (Pydantic Logfire - Optional)
LOGFIRE_TOKEN=
LOGFIRE_MCP_TOKEN=
LOGFIRE_SERVICE_NAME=docunova-boilerplate-api
LOGFIRE_ENABLED=false

# 6. Learning Workspace Safety & Cost Limits
LEARNING_MAX_CARDS=30
LEARNING_MAX_QUESTIONS=20
LEARNING_MAX_NODES=40
LEARNING_MAX_EDGES=80
LEARNING_CONTEXT_CHARS=16000
LEARNING_OUTPUT_CHARS=60000
